# Google Analytics
NEXT_PUBLIC_GA_ID=

# Site URL (used in metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Google Stitch Integration ---
# Option 1: API Key (simplest – generate at stitch.withgoogle.com > Settings > API Keys)
STITCH_API_KEY=

# Option 2: Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# Then set your project ID here:
GOOGLE_CLOUD_PROJECT=

# Optional: override the Stitch service host (default: https://stitch.googleapis.com)
# STITCH_HOST=
