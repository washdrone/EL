# Google Analytics 4 – Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Kontaktformulär – e-postutskick
# ---------------------------------------------------------------------------
# Kanalerna provas i ordning: smtp → webhook → resend → formsubmit. Den första
# som är konfigurerad och lyckas används.
#
# INGET AV DETTA ÄR OBLIGATORISKT: FormSubmit-kanalen kräver inga uppgifter
# och används automatiskt om inget annat är satt. Sätt upp SMTP när du vill
# skicka från din egen brevlåda i stället för via en tredjepartstjänst.
MAIL_CHANNELS=smtp,webhook,resend,formsubmit

# Mottagare av förfrågningar. Kommaseparerad lista tillåten.
# Utelämnas den används CONTACT_EMAIL från src/lib/constants.ts.
LEAD_TO_EMAIL=

# --- Alternativ 1: SMTP (rekommenderat) ------------------------------------
# Fungerar med valfri befintlig brevlåda – webbhotell, Microsoft 365,
# Google Workspace m.fl. Kräver inget godkännande från någon extern tjänst.
# Port 587 = STARTTLS (vanligast), port 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sätts automatiskt utifrån porten – ange bara om du behöver tvinga läget.
SMTP_SECURE=
# Avsändaradress. Utelämnas den används SMTP_USER.
# Måste normalt vara en adress som brevlådan får skicka från.
MAIL_FROM=

# --- Alternativ 2: Webhook -------------------------------------------------
# POST:ar leadet som JSON till valfri endpoint (Zapier, Make, n8n, Slack,
# Google Apps Script). Bra om du hellre vill ha leads i ett kalkylark/CRM.
LEAD_WEBHOOK_URL=
# Skickas i headern X-Lead-Secret om satt, så mottagaren kan verifiera anropet.
LEAD_WEBHOOK_SECRET=

# --- Alternativ 3: Resend (valfri reserv) ----------------------------------
# Används bara om nyckeln är satt. Avsändardomänen måste vara verifierad
# hos Resend.
RESEND_API_KEY=
RESEND_FROM=

# --- Alternativ 4: FormSubmit (standard, kräver ingen konfiguration) -------
# Vidarebefordrar formuläret till LEAD_TO_EMAIL utan konto eller API-nyckel.
# Första gången en ny mottagaradress används skickar tjänsten ett
# aktiveringsmejl dit som måste bekräftas innan leads levereras.
# Sätt till true för att stänga av kanalen helt.
FORMSUBMIT_DISABLED=
# Valfritt: FormSubmits alias-token i stället för adressen i anropet.
FORMSUBMIT_TOKEN=
